{
  "name": "dsh-plugin-pdf-annotator",
  "version": "0.1.2",
  "description": "Select sentences in a PDF, annotate them, and send several annotations to the agent at once",
  "icon": "./icon.svg",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "icon.svg",
    "locale/*.json",
    "lib/index.js",
    "lib/client.js",
    "lib/client.*.js",
    "cordis.patch.yml",
    "THIRD_PARTY_NOTICES.md",
    "third_party/"
  ],
  "engines": {
    "dsh": ">=0.2.1-rc.3 <0.3.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-sidebar-documentpreview",
        "@deepseek-ai/dsh-api-session-controller"
      ]
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --test tests/*.test.ts"
  },
  "devDependencies": {
    "@types/node": "^24.9.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "esbuild": "^0.25.10",
    "pdfjs-dist": "^6.3.289",
    "typescript": "^5.9.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hybridIce/dsh-plugin-pdf-annotator.git"
  },
  "homepage": "https://github.com/hybridIce/dsh-plugin-pdf-annotator#readme",
  "bugs": {
    "url": "https://github.com/hybridIce/dsh-plugin-pdf-annotator/issues"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "pdf",
    "annotations"
  ]
}
